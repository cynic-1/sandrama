[Unit]
Description=SandDrama public reference media upload service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sandrama-upload
Group=sandrama-upload
EnvironmentFile=/etc/sandrama-upload.env
ExecStart=/usr/bin/python3 /opt/sandrama/deploy/sandrama-upload.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sandrama-upload

[Install]
WantedBy=multi-user.target
